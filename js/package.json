{
  "name": "watchbound",
  "version": "0.0.0-development",
  "private": true,
  "description": "Conservative Node.js recursive file watching for Linux with bounded inotify resources and explicit loss reporting",
  "author": "Gadi Cohen <dragon@wastelands.net>",
  "homepage": "https://github.com/gadicc/watchbound#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gadicc/watchbound.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/gadicc/watchbound/issues"
  },
  "keywords": [
    "backpressure",
    "directory-watcher",
    "file-watcher",
    "filesystem",
    "inotify",
    "linux",
    "nodejs",
    "overflow",
    "parcel-watcher",
    "recursive",
    "watcher"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.15.0"
  },
  "os": [
    "linux"
  ],
  "watchbound": {
    "delivery": "controlled-source-build"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "dependencies": {
    "@gadicc/watchbound-node": "workspace:0.0.0-development"
  }
}
