{
  "name": "@gadicc/watchbound-node",
  "version": "0.0.0-development",
  "private": true,
  "description": "Private source workspace for the Watchbound Node-API binding",
  "author": "Gadi Cohen <dragon@wastelands.net>",
  "homepage": "https://github.com/gadicc/watchbound#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gadicc/watchbound.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/gadicc/watchbound/issues"
  },
  "keywords": [
    "filesystem",
    "inotify",
    "linux",
    "napi",
    "watcher"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.15.0"
  },
  "os": [
    "linux"
  ],
  "watchbound": {
    "delivery": "controlled-source-build"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "load-native.cjs",
    "native-matrix.json",
    "watchbound.*.node"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "scripts": {
    "build": "napi build --platform --release --output-dir . --no-js --dts native.generated.d.ts",
    "test": "node test/smoke.cjs && node --test test/loader.cjs test/lifecycle.cjs test/environment-teardown.cjs"
  },
  "napi": {
    "binaryName": "watchbound"
  }
}
